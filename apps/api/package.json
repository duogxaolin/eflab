{
  "name": "@eflab/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "src/server.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "dev": "NODE_ENV=development tsx watch --env-file-if-exists=../../.env src/server.ts",
    "start": "NODE_ENV=production tsx --env-file-if-exists=../../.env src/server.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@better-auth/prisma-adapter": "^1.7.6",
    "@eflab/config": "workspace:*",
    "@eflab/db": "workspace:*",
    "@eflab/shared": "workspace:*",
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^13.0.1",
    "@trpc/server": "^11.0.2",
    "better-auth": "^1.7.6",
    "fastify": "^5.1.0",
    "superjson": "^2.2.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3"
  }
}
