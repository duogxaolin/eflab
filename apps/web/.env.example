# apps/web — environment variables (Next.js)
#
# HOW ENV IS LOADED
#   Next.js itself reads only apps/web/.env* files. This monorepo keeps a single
#   <repo root>/.env (copy <repo root>/.env.example), and apps/web/next.config.ts
#   loads that root file with @next/env (`loadEnvConfig(<repo root>)`) before the
#   build/dev server starts. Precedence, highest first:
#     1. variables already in the shell (CI, `NEXT_PUBLIC_API_URL=… pnpm build`)
#     2. apps/web/.env, .env.local, .env.<mode>          (optional, this file)
#     3. <repo root>/.env, .env.local, .env.<mode>
#   Only NEXT_PUBLIC_* values are inlined into the client bundle, at BUILD time —
#   change one and rebuild (`pnpm --filter @eflab/web build`). Non-prefixed
#   values (R2_* keys, DATABASE_URL, …) never reach the browser.

# Public origin of the tRPC API that the browser calls (inlined at build time).
NEXT_PUBLIC_API_URL="http://localhost:4000"

# Public base URL of the Cloudflare R2 bucket that mirrors the efootbase card
# art (cards/{id}_dynamic.webp, emblems/…). The images are plain <img> (the
# Next image optimiser is off, `images.unoptimized` in next.config.ts). Falls
# back to the dev bucket URL in lib/r2-images.ts when unset. Note:
# flag/emblem URLs stored in the database are rebased by the API (R2_PUBLIC_BASE
# on the API side), so change both when moving the bucket.
NEXT_PUBLIC_R2_PUBLIC_BASE=""

# Build-time FALLBACK of the card image cache version (inlined at build time).
# Card URLs built by lib/r2-images.ts end in `?v=<version>`, because R2 serves
# the objects with `Cache-Control: public, max-age=31536000, immutable` and a
# sync run overwrites changed card images under the same key. The version
# itself is stored in the database (CatalogueMeta.imageVersion), raised by the
# sync worker after such a run and read by the root layout at request time
# (`resolveImageVersion`: stored → this value → the committed default). This
# value only applies while nothing is stored or the API cannot be reached;
# empty = the committed default DEFAULT_IMAGE_VERSION in lib/r2-images.ts.
NEXT_PUBLIC_IMAGE_VERSION=""

# API origin used by server components (detail-page metadata / 404 fetches on
# the Next server). Defaults to NEXT_PUBLIC_API_URL; set it when the Next
# server reaches the API over an internal network (docker service name).
API_INTERNAL_URL=""

# Footer build stamp. next.config.ts fills both from `git rev-parse --short
# HEAD` + the build time when the repository is available; set them explicitly
# in CI/containers without git. When neither is available the stamp is hidden.
NEXT_PUBLIC_GIT_SHA=""
NEXT_PUBLIC_BUILD_UTC=""
