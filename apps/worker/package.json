{
  "name": "@eflab/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "src/main.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "dev": "NODE_ENV=development tsx watch --env-file-if-exists=../../.env src/main.ts",
    "start": "NODE_ENV=production tsx --env-file-if-exists=../../.env src/main.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "NODE_ENV=test SYNC_TEST_MODE=1 tsx test/dump-script.test.ts && NODE_ENV=test SYNC_TEST_MODE=1 tsx test/worker.test.ts &&NODE_ENV=test SYNC_TEST_MODE=1 tsx test/incremental.test.ts && NODE_ENV=test SYNC_TEST_MODE=1 tsx test/full.test.ts",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@eflab/config": "workspace:*",
    "@eflab/db": "workspace:*",
    "@eflab/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3"
  }
}
