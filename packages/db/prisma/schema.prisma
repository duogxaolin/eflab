// eFootball lab — Prisma schema for PostgreSQL 16.
// Models the full efhub SQLite (259 cols) normalized into relational tables.
// BigInt Player IDs (15-digit Konami External PID) — serialized via SuperJSON.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearchPostgres", "postgresqlExtensions", "driverAdapters"]
  output          = "../src/generated"
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  // pg_trgm serves the trigram GIN index on Player.nameNormalized (fuzzy tier of
  // player search); unaccent is kept for ad-hoc SQL. Both are created by the
  // baseline migration so a fresh database bootstraps with `pnpm db:migrate`.
  extensions = [pg_trgm, unaccent]
}

// ---- Enums ----

enum Role {
  USER
  MODERATOR
  ADMIN
}

// One value per efootbase `card_type` code (dump/efootbase/players_meta.json
// `card_type.values`, cross-checked against pack names — see CARD_TYPE_LABELS in
// @eflab/shared and the seeder's card-type validation):
//   0 STANDARD · 1 LEGENDARY · 3 TRENDING (POTW/POTD/POTS) · 4 SELECTION (2022
//   club/league selection packs) · 5 EPIC (incl. Big Time campaigns) ·
//   6 HIGHLIGHT (incl. Show Time + selection packs) · 7 STRIKE_ARENA.
// Big Time and Show Time are pack campaigns inside EPIC / HIGHLIGHT, not codes
// of their own, so the former BIG_TIME / SHOW_TIME values were removed
// (BIG_TIME was renamed to SELECTION in 20261017000100_parity_fixes, because
// the old seeder stored code 4 under that name).
enum CardType {
  STANDARD
  LEGENDARY
  TRENDING
  SELECTION
  EPIC
  HIGHLIGHT
  STRIKE_ARENA
}

// ---- Core: Player card (one player → N card versions, same baseId) ----

model Player {
  id             BigInt    @id
  baseId         BigInt
  name           String
  // efootbase `name_normalized`: lower-case ASCII form of `name` (accents
  // stripped). Search normalises the query the same way in application code
  // (normalizeSearchQuery in @eflab/shared) and matches this column with LIKE
  // (substring tier) and pg_trgm `%` (fuzzy tier) through the GIN index below.
  nameNormalized String?
  accentedName   String?
  japName        String?
  chineseName    String?
  shirt          String?
  shirtNational  String?
  nationalityId  Int
  country2Id     Int?
  height         Int
  weight         Int
  age            Int
  strongerFoot   Int      @default(0)
  registeredPosition Int
  playingStyleAttack  Int   @default(0)
  playingStyleDefense Int   @default(0)
  cardType       CardType
  featuredPackId String?
  dreamTeam      Boolean  @default(false) // efootbase dream_team flag (icon/legend card)
  ovr            Int
  maxOvr         Int
  condition      String   @default("B")
  form           Int      @default(1)
  injuryResistance Int    @default(1)
  weakFootUsage  Int      @default(0)
  weakFootAccuracy Int    @default(0)
  releaseDate    DateTime?
  datapackId     Int      @default(20251204)
  levelCap       Int      @default(50)
  cost           Int      @default(0)
  variation      Int      @default(0)
  stars          Int      @default(0)
  marketValue    Int      @default(0)
  // cross-filled from eFHUB SQLite (efootbase API doesn't expose these; see
  // seed-efhub-crossfill.ts). Stars = card rarity (1-5 ★); reputation = efhub
  // rarity score (0-5, 91% covered); overallPotential = max OVR ceiling at
  // max level (build simulator ceiling).
  reputation        Int      @default(0)
  overallPotential  Int      @default(0)
  boosterId1     Int?
  boosterId2     Int?
  // team link (from efootbase team_name) — nullable since some cards have no club.
  teamId         Int?
  // community metrics from efootbase (views/ratings are efootbase community, not eflab's own).
  views          Int      @default(0)
  ratingCount    Int      @default(0)
  avgRating      Float?
  // 26 base stats (denormalized; value 40–99)
  offensiveAwareness      Int @default(40)
  ballControl            Int @default(40)
  dribbling              Int @default(40)
  tightPossession        Int @default(40)
  lowPass                Int @default(40)
  loftedPass            Int @default(40)
  finishing              Int @default(40)
  heading                Int @default(40)
  placeKicking           Int @default(40)
  curl                   Int @default(40)
  speed                  Int @default(40)
  acceleration           Int @default(40)
  kickingPower           Int @default(40)
  jump                   Int @default(40)
  physicalContact       Int @default(40)
  balance                Int @default(40)
  stamina                Int @default(40)
  defensiveAwareness     Int @default(40)
  ballWinning            Int @default(40)
  defensiveEngagement    Int @default(40)
  aggression             Int @default(40)
  gkAwareness            Int @default(40)
  gkCatching             Int @default(40)
  gkParrying             Int @default(40)
  gkReflexes             Int @default(40)
  gkReach                Int @default(40)
  gkClearing             Int @default(40)
  // ↑ 6th GK stat (cross-filled from eFHUB — efootbase API only exposes 5 GK
  // stats; efhub SQLite has GKClearing for 100% of players).
  // 26 max stats (MAX + base stat name)
  maxOffensiveAwareness      Int @default(40)
  maxBallControl            Int @default(40)
  maxDribbling              Int @default(40)
  maxTightPossession        Int @default(40)
  maxLowPass                Int @default(40)
  maxLoftedPass             Int @default(40)
  maxFinishing              Int @default(40)
  maxHeading                Int @default(40)
  maxPlaceKicking           Int @default(40)
  maxCurl                   Int @default(40)
  maxSpeed                  Int @default(40)
  maxAcceleration           Int @default(40)
  maxKickingPower           Int @default(40)
  maxJump                   Int @default(40)
  maxPhysicalContact       Int @default(40)
  maxBalance                Int @default(40)
  maxStamina                Int @default(40)
  maxDefensiveAwareness     Int @default(40)
  maxBallWinning            Int @default(40)
  maxDefensiveEngagement    Int @default(40)
  maxAggression             Int @default(40)
  maxGkAwareness            Int @default(40)
  maxGkCatching             Int @default(40)
  maxGkParrying             Int @default(40)
  maxGkReflexes             Int @default(40)
  maxGkReach                Int @default(40)
  maxGkClearing             Int @default(40) // 6th GK stat (eFHUB cross-fill)
  // 13 position aptitudes (0=registered,1=secondary,2=none)
  posGK  Int @default(2)
  posCB  Int @default(2)
  posLB  Int @default(2)
  posRB  Int @default(2)
  posDMF Int @default(2)
  posCMF Int @default(2)
  posLMF Int @default(2)
  posRMF Int @default(2)
  posAMF Int @default(2)
  posLWF Int @default(2)
  posRWF Int @default(2)
  posSS  Int @default(2)
  posCF  Int @default(2)
  // 13 per-position OVR ratings — cross-fill-owned (eFHUB overallGK…overallCF via
  // seed-efhub-crossfill.ts). efootbase does not expose them, so the seeder leaves
  // them NULL and the UI shows "n/a" instead of an invented number.
  ratingGK  Int?
  ratingCB  Int?
  ratingLB  Int?
  ratingRB  Int?
  ratingDMF Int?
  ratingCMF Int?
  ratingLMF Int?
  ratingRMF Int?
  ratingAMF Int?
  ratingLWF Int?
  ratingRWF Int?
  ratingSS  Int?
  ratingCF  Int?
  // 11 physique / body model
  neckLength        Int @default(5)
  neckSize          Int @default(5)
  shoulderHeight    Int @default(5)
  shoulderWidth     Int @default(5)
  chestMeasurement  Int @default(5)
  waistSize         Int @default(5)
  armSize           Int @default(5)
  armLength         Int @default(5)
  thighSize         Int @default(5)
  calfSize          Int @default(5)
  legLength         Int @default(5)
  // 5 derived physics (floats)
  legCoverage           Float  @default(0)
  armCoverage           Float  @default(0)
  peakJumpHeight        Float  @default(0)
  torsoCollisionWidth   Float  @default(0)
  dribbleHeight         Float  @default(0)
  // 5 player tactic compat (0–99)
  possessionGame    Int @default(0)
  quickCounter      Int @default(0)
  longBallCounter   Int @default(0)
  outWide           Int @default(0)
  longBall          Int @default(0)
  // AI playstyle flags
  trickster      Boolean @default(false)
  mazingRun      Boolean @default(false)
  speedingBullet Boolean @default(false)
  incisiveRun    Boolean @default(false)
  longBallExpert Boolean @default(false)
  earlyCross     Boolean @default(false)
  // relations
  skills       PlayerSkill[]
  // otherVersions is implemented via a manual `WHERE baseId = ?` (no enforced self-relation FK,
  // since base versions can be missing from a partial dataset).
  packCards    PackCard[]
  team         Team?    @relation(fields: [teamId], references: [id])
  // community tier aggregate (cached)
  communityTier String?
  // efootbase homepage featured bundles (specialPlayerList) — ordered card spots.
  featuredBundleCards FeaturedBundleCard[]

  @@index([baseId])
  @@index([maxOvr])
  @@index([name])
  @@index([nationalityId, registeredPosition])
  @@index([ovr, cardType])
  @@index([teamId])
  // Phase 2 composite indexes for the top filter+sort combos (full-data-seed spec).
  // Postgres btree indexes are usable for both ASC and DESC scans.
  @@index([cardType, ovr])
  @@index([registeredPosition, ovr])
  @@index([nationalityId, ovr])
  // Deterministic pagination: every list orderBy is [{sort}, {id}], so the default
  // Max OVR view, the OVR sort and the release-date (trending) window walk one
  // index with a unique tiebreaker. The single-column cardType/ovr indexes were
  // redundant with (cardType, ovr) and (ovr, id) and were dropped.
  @@index([maxOvr, id])
  @@index([ovr, id])
  @@index([releaseDate, id])
  // Trigram GIN index for accent-insensitive substring + fuzzy name search.
  @@index([nameNormalized(ops: raw("gin_trgm_ops"))], type: Gin)
}

// ---- Manager (efootbase APK bundles 65; efhub latestManagers.json tracks new releases) ----
// efootbase managers.json has only: id, name, rating, booster_1, booster_2, image.
// Other fields (tactic ratings, age, country) default to 0 — not present in efootbase source
// (those come from efhub Firebase, which is client-gated; left as schema placeholder).

model Manager {
  id            BigInt   @id
  name          String
  accentedName  String?
  japName       String?
  chineseName   String?
  age           Int      @default(50)
  country       Int      @default(0)
  adaptability  Int      @default(0)
  affinity      Int      @default(0)
  marketValue   Int      @default(0)
  rating        Int      @default(0)
  imageUrl      String?
  // 6 tactic ratings (0–99) — efootbase does not expose; default 0.
  possessionGame    Int @default(0)
  quickCounter      Int @default(0)
  longBallCounter   Int @default(0)
  outWide           Int @default(0)
  longBall          Int @default(0)
  overload          Int @default(0)
  // boost slots (booster_1/booster_2 from efootbase = stat key slug, not Booster.id)
  boostId1 Int?
  boostId2 Int?
  booster1Stat String?
  booster2Stat String?

  @@index([name])
}

// ---- Booster (efootbase APK efootball_boosters.json: standard + basic tiers) ----
// efootbase bundles boosters with a fixed 27-element `bonus[]` array (statKeys order).
// `tier` ∈ {"standard","basic"}: standard = unique named (BLUE LOCK, Bearer of Fate, Total
// Package); basic = +1 selectable boosters (ids 0-29). Scaled +2/+3/+4/+5 of standard names
// are derived at runtime by the client (not separate rows) — we store the base id only.

model Booster {
  id              Int      @id
  name            String
  japName         String?
  tier            String   @default("basic")   // "standard" | "basic"
  version         Int      @default(0)
  magnitude       Int      @default(2)
  maxMagnitude    Int      @default(4)
  color           Int      @default(0)
  // affected stat magnitudes (sparse — only non-zero entries). Order matches
  // efootbase statKeys: [offensive_awareness, ball_control, tight_possession, dribbling,
  // low_pass, lofted_pass, finishing, set_piece_taking, curl, heading, defensive_awareness,
  // defensive_engagement, tackling, aggression, kicking_power, speed, acceleration, balance,
  // physical_contact, jumping, gk_awareness, gk_catching, gk_parrying, gk_reflexes, gk_reach,
  // stamina, weak_foot_accuracy].
  offensiveAwareness      Int? @default(0)
  ballControl             Int? @default(0)
  dribbling               Int? @default(0)
  tightPossession         Int? @default(0)
  lowPass                 Int? @default(0)
  loftedPass             Int? @default(0)
  finishing               Int? @default(0)
  placeKicking            Int? @default(0)
  curl                    Int? @default(0)
  heading                 Int? @default(0)
  defensiveAwareness      Int? @default(0)
  defensiveEngagement     Int? @default(0)
  ballWinning            Int? @default(0)
  aggression              Int? @default(0)
  kickingPower            Int? @default(0)
  speed                   Int? @default(0)
  acceleration            Int? @default(0)
  balance                 Int? @default(0)
  physicalContact         Int? @default(0)
  jump                    Int? @default(0)
  stamina                 Int? @default(0)
  gkAwareness             Int? @default(0)
  gkCatching              Int? @default(0)
  gkParrying              Int? @default(0)
  gkReflexes              Int? @default(0)
  gkReach                 Int? @default(0)
  weakFootAccuracy        Int? @default(0)

  @@index([tier])
}

// ---- Skill (67) ----

model Skill {
  id          Int    @id
  slug        String @unique
  name        String
  description String @default("")
  category    String @default("General")
  players     PlayerSkill[]

  @@index([category])
}

model PlayerSkill {
  playerId BigInt
  skillId  Int
  player   Player @relation(fields: [playerId], references: [id], onDelete: Cascade)
  skill    Skill  @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([playerId, skillId])
  @@index([skillId])
}

// ---- Pack + Team + Country + League ----

model Pack {
  id          String @id
  name        String
  releaseDate DateTime
  type        String   @default("pack")
  playerCount Int      @default(0)
  cards       PackCard[]

  @@index([type])
}

model PackCard {
  packId    String
  playerId  BigInt
  pack      Pack   @relation(fields: [packId], references: [id], onDelete: Cascade)
  player    Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@id([packId, playerId])
}

// ---- FeaturedBundle (efootbase homepage "specialPlayerList") ----
// Source: dump/efootbase/packs.json → data.specialPlayerList (17 bundles).
// Each bundle = a homepage "Latest Packs" section: short display title (`name`),
// release timestamp (`time` → releaseDate), and an ordered list of player cards
// (`list` array → FeaturedBundleCard.ordinal preserves efootbase's exact display
// order, including legend spotlights pulled from other packs). Note: this is
// distinct from Pack/PackCard (seeded from the player `featured` field, 2.065
// historical packs) — FeaturedBundle is efootbase's curated homepage carousel.

model FeaturedBundle {
  id          Int      @id @default(autoincrement())
  name        String   // short display title ("Spanish League Midfielders", "Netherlands")
  slug        String   @unique // stable id from efootbase name (for re-seed idempotency)
  releaseDate DateTime // from efootbase `time` epoch
  position    Int      @default(0) // index in specialPlayerList (sort tiebreaker)
  cards       FeaturedBundleCard[]

  @@index([releaseDate, position])
}

model FeaturedBundleCard {
  bundleId Int
  playerId BigInt
  ordinal  Int // display order (index in efootbase `list` array)
  bundle   FeaturedBundle @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  player   Player          @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@id([bundleId, playerId])
  @@index([bundleId, ordinal])
  @@index([playerId])
}

model Team {
  id        Int     @id
  name      String
  countryId Int?
  leagueId  Int?
  national  Boolean @default(false)
  emblemUrl String?
  country   Country? @relation(fields: [countryId], references: [id], onDelete: SetNull)
  league    League?  @relation(fields: [leagueId], references: [id], onDelete: SetNull)
  players   Player[]

  @@index([leagueId])
  @@index([countryId])
}

model Country {
  id        Int     @id
  name      String
  region    String?
  continent String?
  flagUrl   String?

  teams Team[]
}

model League {
  id        Int     @id
  name      String
  region    String?
  emblemUrl String?

  teams Team[]
}

// ---- Auth (User + Session + Account; the `auth` router and Google OAuth) ----
// The user-content tables (Build, Review, TierVote, TierList, Follow, Post,
// PostLike, Comment) were dropped in migration 20261018000000_remove_dead_surface
// (change remove-dead-surface) — nothing served them after the web shrank to the
// four efootbase pages.

model User {
  id             String   @id @default(cuid())
  username       String   @unique
  email          String   @unique
  emailVerified  Boolean  @default(false)
  displayName    String?
  region         String?
  country        String?
  avatarUrl      String?
  isPro          Boolean  @default(false)
  proUntil       DateTime?
  role           Role     @default(USER)
  followersCount Int      @default(0)
  followingCount Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  sessions       Session[]
  accounts       Account[]

  @@index([username])
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id              String   @id @default(cuid())
  userId          String
  providerId      String
  accountId       String
  providerType    String   @default("oauth")
  accessToken     String?
  refreshToken    String?
  accessTokenExpiresAt DateTime?
  refreshTokenExpiresAt DateTime?
  scope           String?
  passwordHashed  String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
}
