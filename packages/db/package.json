{
  "name": "@eflab/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./prisma": "./src/prisma.ts",
    "./client": "./src/client.ts",
    "./admin-auth": "./src/admin-auth.ts",
    "./efootbase-map": "./src/efootbase-map.ts",
    "./upsert": "./src/upsert.ts",
    "./boosters": "./src/boosters.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf src/generated dist .turbo",
    "db:generate": "prisma generate --schema=prisma/schema.prisma",
    "db:push": "prisma db push --schema=prisma/schema.prisma",
    "db:migrate": "prisma migrate deploy --schema=prisma/schema.prisma",
    "db:migrate:dev": "prisma migrate dev --schema=prisma/schema.prisma",
    "db:seed": "tsx --env-file-if-exists=../../.env src/seed-efootbase-full.ts",
    "db:crossfill": "tsx --env-file-if-exists=../../.env src/seed-efhub-crossfill.ts",
    "db:refresh": "pnpm run db:seed && pnpm run db:crossfill",
    "admin:create": "tsx --env-file-if-exists=../../.env src/admin-cli.ts create",
    "admin:set-password": "tsx --env-file-if-exists=../../.env src/admin-cli.ts set-password",
    "admin:disable": "tsx --env-file-if-exists=../../.env src/admin-cli.ts disable",
    "test": "tsx src/admin-auth.test.ts && tsx src/efootbase-map.test.ts && tsx src/boosters.test.ts"
  },
  "dependencies": {
    "@eflab/config": "workspace:*",
    "@eflab/shared": "workspace:*",
    "@prisma/client": "^6.19.3"
  },
  "devDependencies": {
    "prisma": "^6.19.3",
    "tsx": "^4.19.2"
  }
}
