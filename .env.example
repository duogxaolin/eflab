# eFootball lab — environment variables

# PostgreSQL (docker-compose) — port 5433 to avoid local ServBay Postgres conflict
DATABASE_URL="postgresql://eflab:eflab_dev@localhost:5433/eflab?schema=public"

# API server
API_PORT=4000

# Web (Next.js)
NEXT_PUBLIC_API_URL="http://localhost:4000"

# Google OAuth (Google Cloud Console → APIs & Services → Credentials → OAuth 2.0)
# Create an OAuth client; set the Authorized redirect URI to the API origin's
# callback: http://localhost:4000/auth/google/callback (dev) / <api origin>/auth/google/callback (prod)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# OAuth callback origins — the post-login redirect target + the API's own origin.
# Defaults to http://localhost:3000 / http://localhost:4000 when unset.
WEB_ORIGIN="http://localhost:3000"
API_ORIGIN="http://localhost:4000"

# Cloudflare R2 — efootbase images (eflab web image pipeline, see CLAUDE.md).
# Đổi domain R2 chỉ cần sửa R2_PUBLIC_BASE / NEXT_PUBLIC_R2_PUBLIC_BASE (vd. add custom domain cdn.eflab.app).
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=footlab
R2_PUBLIC_BASE=""
NEXT_PUBLIC_R2_PUBLIC_BASE=""
