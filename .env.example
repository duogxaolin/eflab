# eFootLab — environment variables (copy to .env; .env is gitignored, this repo is PUBLIC)
#
# One root .env serves everything: the API and the db scripts load it with
# `tsx --env-file-if-exists=../../.env`, the Python scripts parse it, and
# apps/web/next.config.ts loads it through @next/env (see apps/web/.env.example
# for precedence). Shell variables always win over this file.

# ---- Database (docker-compose: postgres bound to 127.0.0.1:5433) ----
DATABASE_URL="postgresql://eflab:eflab_dev@localhost:5433/eflab?schema=public"

# ---- API (apps/api/src/env.ts) ----
API_PORT=4000
API_HOST="0.0.0.0"
API_ORIGIN="http://localhost:4000"
# Comma-separated browser origins allowed by CORS; the first one is where the
# Google OAuth callback redirects afterwards.
WEB_ORIGIN="http://localhost:3000,http://127.0.0.1:3000"
# NODE_ENV is set by the package scripts (api `dev` = development, `start` =
# production). Unset = treated as production (no stack traces, Secure cookies).

# ---- Google OAuth (optional — Google Cloud Console → Credentials → OAuth 2.0) ----
# Authorized redirect URI: <API_ORIGIN>/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Random secret that signs the OAuth state cookie (any long random string).
OAUTH_STATE_SECRET=""

# ---- Web (apps/web; NEXT_PUBLIC_* are inlined into the client bundle at BUILD time) ----
NEXT_PUBLIC_API_URL="http://localhost:4000"
# API origin used by the Next server components (detail-page 404/metadata
# fetches). Defaults to NEXT_PUBLIC_API_URL; set it for container networks.
API_INTERNAL_URL=""
# Footer build stamp — filled from git by next.config.ts when available.
NEXT_PUBLIC_GIT_SHA=""
NEXT_PUBLIC_BUILD_UTC=""

# ---- Cloudflare R2 (card art, flags, emblems, manager art) ----
# Bucket `efootlab`. Credentials are used only by scripts/r2_upload.py — run by
# hand, or as the sync worker's upload step (the worker hands the R2_* values to
# that child only). Note: every process that loads this file (API, db scripts,
# next.config.ts, worker) has them in its environment; to keep them in the
# worker only, leave them empty here and give them to the worker service from a
# separate 0600 file (docs/admin-sync.md).
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=efootlab
# Public base URL of the bucket (no trailing slash), e.g. https://pub-xxxx.r2.dev
# or a custom domain. Moving the bucket = set BOTH values and rebuild the web app:
#   R2_PUBLIC_BASE             → the API rebases the absolute flag/emblem/manager
#                                URLs stored in the database onto it; the seeder
#                                also uses it when writing new rows.
#   NEXT_PUBLIC_R2_PUBLIC_BASE → the web builds card/condition URLs from it and
#                                restricts next/image to that host.
# Leave both empty to use the dev bucket URL hard-coded in the code.
R2_PUBLIC_BASE=""
NEXT_PUBLIC_R2_PUBLIC_BASE=""
# Card image cache version, appended as `?v=` to cards/{id}_dynamic.webp and
# cards/{id}_transparent.webp (R2 serves them `immutable` for a year). Bump it
# after card images are overwritten in place on R2, then rebuild the web app.
# Empty = the committed default DEFAULT_IMAGE_VERSION in apps/web/lib/r2-images.ts.
NEXT_PUBLIC_IMAGE_VERSION=""

# ---- Seeders (packages/db) ----
# Defaults: dump/efootbase/players.jsonl, players_meta.json, packs.json, static/
# Leave these lines commented unless you set a real path: the seed uses any
# value that is set — an EMPTY one included — instead of its default, so an
# empty line here would silently replace the default location.
# EFOOTBASE_DUMP_PATH=/absolute/path/to/players.jsonl
# EFOOTBASE_META_PATH=/absolute/path/to/players_meta.json
# EFOOTBASE_PACKS_PATH=/absolute/path/to/packs.json
# Static efootbase snapshot (skills.json, managers.json, skill-icons/) — also
# the directory the sync worker's full run hands to the seed. Same rule, and
# worse: the seed treats an EMPTY value as a directory, finds no skills.json
# there and erases the skill metadata.
# EFOOTBASE_STATIC_DIR=/absolute/path/to/static
# eFHUB cross-fill: SQLite file (default dump/efhub/efhub_db.sqlite) and the
# sqlite3 CLI used to read it (default `sqlite3` on PATH; ServBay: /Applications/ServBay/bin/sqlite3).
EFHUB_DB_PATH=""
SQLITE3_BIN=""

# ---- Scripts ----
# EFBASE_API_KEY: scripts/efootbase_dump.py reads it from the .env passed with
# `--env` (`python3 scripts/efootbase_dump.py --env .env`); the sync worker reads
# it from its environment (this file or the service's) and hands it to the dump
# child through the environment (`--key-from-env`). Keep it empty here and never
# commit a real value.
EFBASE_API_KEY=""
# scripts/verify-seed.py: psql binary (default: `psql` on PATH, then docker exec).
PSQL=""

# ---- Sync worker (apps/worker; docs/admin-sync.md) ----
# Also reads DATABASE_URL, EFBASE_API_KEY, R2_* (R2_PUBLIC_BASE is required by
# incremental and full runs) and EFOOTBASE_STATIC_DIR from above.
# Optional API base (default: the real efootbase API; tests: a loopback fake).
EFBASE_API_BASE=""
# Python interpreter for the scripts (default python3; needs boto3 for uploads).
SYNC_PYTHON=""
# Optional JSON array argv replacing [python, scripts/r2_upload.py] (tests only).
SYNC_R2_UPLOAD_CMD=""
# Test mode (also NODE_ENV=test): loopback source, eflab_synctest* database,
# stand-in upload. Never set it for a real worker.
SYNC_TEST_MODE=""
# Admin accounts: `pnpm admin:create|admin:set-password|admin:disable <name>`
# ask for the password at a hidden prompt. ADMIN_PASSWORD (environment) replaces
# the prompt for automation — do NOT store it in this file.
